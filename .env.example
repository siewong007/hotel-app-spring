# Copy to .env and edit. Compose refuses to start until the two required
# values are set, mirroring the original repository's guard.
POSTGRES_PASSWORD=
JWT_SECRET=

POSTGRES_USER=hotel_admin
POSTGRES_DB=hotel_management
ENVIRONMENT=production
BACKEND_PORT=3030
# Comma-separated origins; use * only for local desktop-style usage.
ALLOWED_ORIGINS=http://localhost,http://localhost:3000
TRUST_PROXY_HEADERS=true

# Optional backend integrations (same names as the Rust backend reads).
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
PASSKEY_RP_ID=localhost
SKIP_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
RBAC_CACHE_TTL_SECS=30
SETTINGS_CACHE_TTL_SECS=30
DATABASE_MAX_CONNECTIONS=20
VITE_API_URL=
